<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TikTok Downloader - Always Rizz</title>
  
  <link rel="icon" type="image/jpg" href="/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    body {
      min-height: 100vh;
      background: #0a0a0a;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #ffffff;
    }

    .container {
      width: 100%;
      max-width: 420px;
      background: #1a1a1a;
      border-radius: 20px;
      padding: 24px 20px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
      border: 1px solid #2a2a2a;
      position: relative;
      animation: fadeInUp 0.5s ease forwards;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #888;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 16px;
      transition: all 0.3s ease;
      cursor: pointer;
      background: none;
      border: none;
    }

    .back-btn:hover {
      color: #ffffff;
    }

    .back-btn i {
      font-size: 1rem;
    }

    .header {
      margin-bottom: 16px;
    }

    .header .title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #ffffff;
    }

    .header .subtitle {
      font-size: 0.75rem;
      color: #666;
      margin-top: 2px;
    }

    /* ===== INPUT ===== */
    .input-group {
      display: flex;
      gap: 10px;
      margin-bottom: 16px;
    }

    .input-group input {
      flex: 1;
      padding: 12px 16px;
      border: 1px solid #2a2a2a;
      border-radius: 12px;
      font-size: 0.85rem;
      outline: none;
      transition: all 0.3s ease;
      background: #0a0a0a;
      color: #ffffff;
    }

    .input-group input:focus {
      border-color: #6366f1;
      background: #111;
    }

    .input-group input::placeholder {
      color: #555;
    }

    .btn-search {
      padding: 12px 20px;
      background: #6366f1;
      color: #ffffff;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .btn-search:hover {
      background: #4f46e5;
      transform: scale(1.02);
    }

    .btn-search:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* ===== NOTIFIKASI ===== */
    .notification {
      display: none;
      padding: 10px 14px;
      background: #2a2a2a;
      border-radius: 10px;
      font-size: 0.8rem;
      color: #aaa;
      margin-bottom: 16px;
      border-left: 3px solid #f59e0b;
    }

    .notification.show {
      display: block;
      animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .notification .notif-icon {
      margin-right: 8px;
    }

    .notification .notif-link {
      color: #6366f1;
      text-decoration: none;
    }

    .notification .notif-link:hover {
      text-decoration: underline;
    }

    /* ===== LOADING ===== */
    .loading {
      display: none;
      text-align: center;
      padding: 30px 0;
    }

    .loading.show {
      display: block;
    }

    .loading .spinner {
      display: inline-block;
      width: 30px;
      height: 30px;
      border: 3px solid #2a2a2a;
      border-top-color: #6366f1;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading p {
      margin-top: 10px;
      color: #666;
      font-size: 0.85rem;
    }

    /* ===== ERROR ===== */
    .error-msg {
      display: none;
      padding: 12px 14px;
      background: #2a1a1a;
      border: 1px solid #442222;
      border-radius: 10px;
      color: #ef4444;
      font-size: 0.85rem;
      margin-bottom: 16px;
    }

    .error-msg.show {
      display: block;
      animation: slideDown 0.3s ease;
    }

    /* ===== RESULT ===== */
    .result-box {
      display: none;
      margin-top: 16px;
      animation: fadeIn 0.5s ease;
    }

    .result-box.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .result-box .video-container {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      background: #0a0a0a;
      margin-bottom: 12px;
    }

    .result-box .video-container video {
      width: 100%;
      display: block;
      max-height: 500px;
      object-fit: cover;
    }

    .result-box .video-container .play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 56px;
      height: 56px;
      background: rgba(99, 102, 241, 0.9);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #ffffff;
      cursor: pointer;
      transition: all 0.3s ease;
      border: none;
    }

    .result-box .video-container .play-btn:hover {
      background: #4f46e5;
      transform: translate(-50%, -50%) scale(1.1);
    }

    .result-box .video-container .play-btn.hidden {
      display: none;
    }

    .result-box .video-container .duration {
      position: absolute;
      bottom: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.8);
      padding: 2px 10px;
      border-radius: 6px;
      font-size: 0.7rem;
      color: #ffffff;
    }

    /* ===== INFO VIDEO ===== */
    .result-box .video-info {
      margin-bottom: 12px;
    }

    .result-box .video-info .author {
      font-weight: 700;
      font-size: 0.95rem;
      color: #ffffff;
    }

    .result-box .video-info .username {
      color: #666;
      font-size: 0.8rem;
    }

    .result-box .video-info .caption {
      color: #aaa;
      font-size: 0.85rem;
      margin-top: 2px;
      line-height: 1.4;
    }

    .result-box .video-info .stats {
      display: flex;
      gap: 16px;
      margin-top: 6px;
      font-size: 0.75rem;
      color: #666;
    }

    .result-box .video-info .stats span {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* ===== BUTTON DOWNLOAD ===== */
    .result-box .download-buttons {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .result-box .download-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px;
      border: none;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      color: #ffffff;
      width: 100%;
    }

    .result-box .download-btn:hover {
      transform: translateY(-2px);
    }

    .result-box .download-btn.video {
      background: #6366f1;
    }

    .result-box .download-btn.video:hover {
      background: #4f46e5;
      box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
    }

    .result-box .download-btn.audio {
      background: #2a2a2a;
      border: 1px solid #3a3a3a;
    }

    .result-box .download-btn.audio:hover {
      background: #3a3a3a;
      border-color: #6366f1;
    }

    .result-box .download-btn i {
      font-size: 1.1rem;
    }

    .footer {
      margin-top: 20px;
      text-align: center;
      font-size: 0.7rem;
      color: #444;
      padding-top: 14px;
      border-top: 1px solid #2a2a2a;
    }

    @media (max-width: 480px) {
      .container {
        padding: 16px 14px;
        border-radius: 16px;
      }
      .input-group {
        flex-direction: column;
      }
      .btn-search {
        width: 100%;
        justify-content: center;
      }
      .result-box .video-container video {
        max-height: 350px;
      }
    }
  </style>
</head>
<body>

  <div class="container">

    <!-- Back Button -->
    <button class="back-btn" onclick="history.back()">
      <i class="fa-solid fa-arrow-left"></i> Kembali
    </button>

    <!-- Header -->
    <div class="header">
      <div class="title">⬇️ TikTok Downloader</div>
      <div class="subtitle">Stories, Audio, Foto &amp; Video Without Watermark</div>
    </div>

    <!-- Input -->
    <div class="input-group">
      <input type="text" id="urlInput" placeholder="https://vt.tiktok.com/...">
      <button class="btn-search" id="searchBtn">
        <i class="fa-solid fa-magnifying-glass"></i> Search
      </button>
    </div>

    <!-- Notification -->
    <div class="notification" id="notification">
      <span class="notif-icon">⏳</span>
      <span id="notifText">Mendownload 1 file ...</span>
      <br>
      <span style="font-size:0.7rem;color:#666;">
        <i class="fa-regular fa-bell"></i> 
        Lihat notifikasi untuk mengetahui status download
      </span>
    </div>

    <!-- Loading -->
    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p>Sedang memproses...</p>
    </div>

    <!-- Error -->
    <div class="error-msg" id="errorMsg"></div>

    <!-- Result -->
    <div class="result-box" id="resultBox">

      <!-- Video Player -->
      <div class="video-container">
        <video id="videoPlayer" controls style="width:100%;display:none;">
          <source id="videoSource" src="" type="video/mp4">
          Your browser does not support the video tag.
        </video>
        <button class="play-btn" id="playBtn">
          <i class="fa-solid fa-play"></i>
        </button>
        <div class="duration" id="duration">0:00</div>
      </div>

      <!-- Info -->
      <div class="video-info">
        <div class="author" id="authorName">@username</div>
        <div class="caption" id="captionText">Caption video</div>
        <div class="stats" id="statsText">
          <span><i class="fa-regular fa-eye"></i> 0</span>
          <span><i class="fa-regular fa-heart"></i> 0</span>
          <span><i class="fa-regular fa-comment"></i> 0</span>
          <span><i class="fa-regular fa-share"></i> 0</span>
        </div>
      </div>

      <!-- Download Buttons -->
      <div class="download-buttons">
        <a href="#" class="download-btn video" id="downloadVideo" target="_blank" download>
          <i class="fa-solid fa-download"></i> DOWNLOAD VIDEO
        </a>
        <a href="#" class="download-btn audio" id="downloadAudio" target="_blank" download>
          <i class="fa-solid fa-music"></i> DOWNLOAD AUDIO (MP3)
        </a>
      </div>
    </div>

    <div class="footer">
      © 2026 • Always Riz Official
    </div>
  </div>

  <script>
    // ===== ELEMEN =====
    const urlInput = document.getElementById('urlInput');
    const searchBtn = document.getElementById('searchBtn');
    const resultBox = document.getElementById('resultBox');
    const loading = document.getElementById('loading');
    const errorMsg = document.getElementById('errorMsg');
    const notification = document.getElementById('notification');
    const notifText = document.getElementById('notifText');

    // Video elements
    const videoPlayer = document.getElementById('videoPlayer');
    const videoSource = document.getElementById('videoSource');
    const playBtn = document.getElementById('playBtn');
    const duration = document.getElementById('duration');

    // Info elements
    const authorName = document.getElementById('authorName');
    const captionText = document.getElementById('captionText');
    const statsText = document.getElementById('statsText');

    // Download buttons
    const downloadVideo = document.getElementById('downloadVideo');
    const downloadAudio = document.getElementById('downloadAudio');

    const API_KEY = 'FreeByFhkry';

    // ===== FORMAT ANGKA =====
    function formatNumber(num) {
      if (!num) return '0';
      if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
      if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
      return num.toString();
    }

    // ===== FORMAT DURASI =====
    function formatDuration(seconds) {
      if (!seconds) return '0:00';
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    }

    // ===== SHOW ERROR =====
    function showError(msg) {
      errorMsg.textContent = '❌ ' + msg;
      errorMsg.classList.add('show');
    }

    // ===== HIDE ERROR =====
    function hideError() {
      errorMsg.classList.remove('show');
    }

    // ===== SHOW NOTIFICATION =====
    function showNotification(msg) {
      notifText.textContent = msg;
      notification.classList.add('show');
    }

    // ===== HIDE NOTIFICATION =====
    function hideNotification() {
      notification.classList.remove('show');
    }

    // ===== MAIN SEARCH =====
    async function handleSearch() {
      const url = urlInput.value.trim();

      if (!url) {
        showError('Masukkan URL TikTok terlebih dahulu!');
        return;
      }

      // Reset
      hideError();
      hideNotification();
      resultBox.classList.remove('active');
      videoPlayer.style.display = 'none';
      playBtn.classList.remove('hidden');
      downloadAudio.style.display = 'none';

      // Show loading
      loading.classList.add('show');
      searchBtn.disabled = true;

      try {
        console.log('📤 Fetching TikTok...', url);

        const response = await fetch(`/api/download/tiktok?apikey=${API_KEY}&url=${encodeURIComponent(url)}`);
        const data = await response.json();

        loading.classList.remove('show');
        searchBtn.disabled = false;

        console.log('📥 Response:', data);

        if (!data.status) {
          throw new Error(data.error || 'Gagal mendapatkan data');
        }

        const result = data.result;

        // ===== TAMPILKAN HASIL =====

        // 1. Notifikasi
        showNotification('Mendownload 1 file ...');

        // 2. Video Player
        if (result.video) {
          videoSource.src = result.video;
          videoPlayer.load();
          videoPlayer.style.display = 'block';
          playBtn.classList.add('hidden');

          // Set duration
          if (result.duration) {
            duration.textContent = formatDuration(result.duration);
          }
        }

        // 3. Info
        authorName.textContent = `@${result.unique_id || 'username'}`;
        captionText.textContent = result.title || 'TikTok Video';

        // Stats
        let statsHtml = '';
        if (result.play_count) statsHtml += `<span><i class="fa-regular fa-eye"></i> ${formatNumber(result.play_count)}</span>`;
        if (result.like_count) statsHtml += `<span><i class="fa-regular fa-heart"></i> ${formatNumber(result.like_count)}</span>`;
        if (result.comment_count) statsHtml += `<span><i class="fa-regular fa-comment"></i> ${formatNumber(result.comment_count)}</span>`;
        if (result.share_count) statsHtml += `<span><i class="fa-regular fa-share"></i> ${formatNumber(result.share_count)}</span>`;
        statsText.innerHTML = statsHtml || '<span>No stats</span>';

        // 4. Download Buttons
        if (result.video) {
          downloadVideo.href = result.video;
          downloadVideo.style.display = 'flex';
        } else {
          downloadVideo.style.display = 'none';
        }

        if (result.audio) {
          downloadAudio.href = result.audio;
          downloadAudio.style.display = 'flex';
        } else {
          downloadAudio.style.display = 'none';
        }

        // 5. Tampilkan result
        resultBox.classList.add('active');

        console.log('✅ Success!');

      } catch (error) {
        console.error('❌ Error:', error.message);
        loading.classList.remove('show');
        searchBtn.disabled = false;
        showError(error.message || 'Gagal memproses video');
      }
    }

    // ===== PLAY BUTTON =====
    playBtn.addEventListener('click', function() {
      videoPlayer.play();
      this.classList.add('hidden');
    });

    // ===== EVENT LISTENERS =====
    searchBtn.addEventListener('click', handleSearch);

    urlInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        handleSearch();
      }
    });

    console.log('⬇️ TikTok Downloader siap digunakan!');
  </script>

</body>
</html>